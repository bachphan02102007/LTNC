<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AuctionRoomController"
            style="-fx-background-color: #f4f6f9;">

    <!-- ═══ TOP BAR ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1a1a2e; -fx-padding: 12 24;">
            <VBox spacing="2">
                <Label fx:id="labelAuctionId"  text="Phiên: —"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="labelItemName" text="Sản phẩm: —"
                       style="-fx-text-fill: #aaa; -fx-font-size: 12px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Countdown clock -->
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #2d2d44; -fx-padding: 8 16;
                         -fx-background-radius: 8;">
                <Label text="⏱ Còn lại" style="-fx-text-fill: #aaa; -fx-font-size: 10px;"/>
                <Label fx:id="labelCountdown" text="--:--"
                       style="-fx-text-fill: #f0c040; -fx-font-size: 22px;
                              -fx-font-weight: bold;"/>
            </VBox>

            <Label fx:id="labelStatus" text="⏳ Đang kết nối..."
                   style="-fx-text-fill: #aaa; -fx-font-size: 12px;"/>

            <Button text="← Quay lại" onAction="#handleBack"
                    style="-fx-background-color: #3d5a80; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-padding: 6 14;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- ═══ CENTER ═══ -->
    <center>
        <HBox spacing="16" style="-fx-padding: 16;">

            <!-- LEFT: Giá + form đặt giá + log -->
            <VBox spacing="12" minWidth="320" HBox.hgrow="ALWAYS">

                <!-- Giá cao nhất -->
                <VBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: white; -fx-padding: 20;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                    <Label text="Giá cao nhất hiện tại"
                           style="-fx-text-fill: #666; -fx-font-size: 13px;"/>
                    <Label fx:id="labelCurrentBid" text="—"
                           style="-fx-font-size: 36px; -fx-font-weight: bold;
                                  -fx-text-fill: #e05c00;"/>
                    <Label fx:id="labelLeader" text="Người dẫn đầu: —"
                           style="-fx-text-fill: #888; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Form đặt giá -->
                <VBox spacing="8"
                      style="-fx-background-color: white; -fx-padding: 16;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                    <Label text="Đặt giá của bạn"
                           style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="fieldBidAmount"
                                   promptText="Nhập số tiền (VNĐ)"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 15px; -fx-padding: 10;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-border-color: #ccc;"/>
                        <Button fx:id="buttonBid" text="🔨 ĐẶT GIÁ"
                                onAction="#handleBid"
                                style="-fx-background-color: #e05c00; -fx-text-fill: white;
                                       -fx-font-size: 14px; -fx-font-weight: bold;
                                       -fx-padding: 10 20; -fx-background-radius: 8;
                                       -fx-cursor: hand;"/>
                    </HBox>
                    <!-- Quick bid buttons -->
                    <HBox spacing="8">
                        <Button text="+100k"  onAction="#handleQuickBid100"
                                style="-fx-background-color: #e8f4fd; -fx-text-fill: #2980b9;
                                       -fx-border-color: #2980b9; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 5 10;"/>
                        <Button text="+500k"  onAction="#handleQuickBid500"
                                style="-fx-background-color: #e8f4fd; -fx-text-fill: #2980b9;
                                       -fx-border-color: #2980b9; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 5 10;"/>
                        <Button text="+1 triệu" onAction="#handleQuickBid1000"
                                style="-fx-background-color: #e8f4fd; -fx-text-fill: #2980b9;
                                       -fx-border-color: #2980b9; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 5 10;"/>
                    </HBox>
                    <Label fx:id="labelBidResult" text=""
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                </VBox>

                <!-- Activity log -->
                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <Label text="📢 Hoạt động phòng"
                           style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                    <ListView fx:id="listViewLog" VBox.vgrow="ALWAYS"
                              style="-fx-font-size: 12px; -fx-background-radius: 8;
                                     -fx-border-color: #e0e0e0;"/>
                </VBox>
            </VBox>

            <!-- RIGHT: Bid history table -->
            <VBox spacing="8" prefWidth="340">
                <Label text="📋 Lịch sử đặt giá"
                       style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                <TableView fx:id="tableBidHistory" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #e0e0e0;">
                    <columns>
                        <TableColumn fx:id="colBidder" text="Người đặt" prefWidth="120"/>
                        <TableColumn fx:id="colAmount" text="Số tiền"   prefWidth="120"/>
                        <TableColumn fx:id="colTime"   text="Thời gian" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Chưa có lượt đặt giá nào."
                               style="-fx-text-fill: #aaa;"/>
                    </placeholder>
                </TableView>

                <!-- Item info card -->
                <VBox spacing="6"
                      style="-fx-background-color: white; -fx-padding: 14;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                    <Label text="📦 Thông tin sản phẩm"
                           style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Separator/>
                    <HBox spacing="8">
                        <Label text="Danh mục:"
                               style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="labelCategory"
                               style="-fx-text-fill: #333; -fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Giá khởi điểm:"
                               style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="labelStartPrice"
                               style="-fx-text-fill: #333; -fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Số lượt đặt:"
                               style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="labelBidCount" text="0"
                               style="-fx-text-fill: #333; -fx-font-size: 12px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
