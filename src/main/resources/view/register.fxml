<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.RegisterController"
           prefWidth="1000"
           prefHeight="700"
           style="-fx-background-color: linear-gradient(to bottom right, #e0f2fe, #ffffff);">

    <Pane>
        <Circle radius="190" layoutX="130" layoutY="120" fill="#38bdf855"/>
        <Circle radius="230" layoutX="820" layoutY="560" fill="#2563eb33"/>
        <Circle radius="95" layoutX="760" layoutY="120" fill="#bae6fd"/>
    </Pane>

    <HBox alignment="CENTER"
          maxWidth="820"
          maxHeight="540"
          style="-fx-background-color: white;
                 -fx-background-radius: 34;
                 -fx-border-radius: 34;
                 -fx-border-color: #dbeafe;
                 -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.20), 35, 0, 0, 12);">

        <VBox spacing="20" alignment="CENTER_LEFT" prefWidth="380" style="-fx-padding: 45;">
            <Label text="JOIN AUCTION"
                   style="-fx-text-fill: #0284c7; -fx-font-size: 13px; -fx-font-weight: bold;"/>

            <Label text="Tạo Tài Khoản&#10;Đấu Giá"
                   style="-fx-text-fill: #0f172a; -fx-font-size: 40px; -fx-font-weight: bold;"/>

            <Label text="Đăng ký tài khoản để tham gia đấu giá, đặt giá và quản lý các phiên dễ dàng hơn."
                   wrapText="true"
                   style="-fx-text-fill: #475569; -fx-font-size: 14px; -fx-line-spacing: 4;"/>
        </VBox>

        <VBox alignment="CENTER"
              spacing="13"
              prefWidth="410"
              style="-fx-background-color: #f8fbff; -fx-background-radius: 34; -fx-padding: 38;">

            <Label text="Đăng ký"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <TextField fx:id="usernameField" promptText="Tên đăng nhập"
                       style="-fx-pref-width: 300; -fx-pref-height: 44; -fx-background-color: white;
                              -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #bfdbfe;
                              -fx-padding: 0 14;"/>

            <PasswordField fx:id="passwordField" promptText="Mật khẩu"
                           style="-fx-pref-width: 300; -fx-pref-height: 44; -fx-background-color: white;
                                  -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #bfdbfe;
                                  -fx-padding: 0 14;"/>

            <PasswordField fx:id="confirmField" promptText="Xác nhận mật khẩu"
                           style="-fx-pref-width: 300; -fx-pref-height: 44; -fx-background-color: white;
                                  -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #bfdbfe;
                                  -fx-padding: 0 14;"/>

            <ComboBox fx:id="roleCombo"
                      promptText="Chọn vai trò"
                      style="-fx-pref-width: 300; -fx-pref-height: 44; -fx-background-color: white;
                             -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #bfdbfe;"/>

            <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
            <Label fx:id="successLabel" text="" wrapText="true" style="-fx-text-fill: #0284c7; -fx-font-size: 12px;"/>

            <Button text="Đăng Ký"
                    onAction="#handleRegister"
                    style="-fx-pref-width: 300; -fx-pref-height: 48;
                           -fx-background-color: linear-gradient(to right, #38bdf8, #2563eb);
                           -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"/>

            <Button text="Đăng nhập"
                    onAction="#handleGoLogin"
                    style="-fx-background-color: transparent; -fx-text-fill: #0284c7;
                           -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </HBox>
</StackPane>