<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.SellerController"
            prefWidth="1300"
            prefHeight="770"
            style="-fx-background-color: linear-gradient(to bottom right, #eff6ff, #ffffff);">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              style="-fx-background-color: white;
                     -fx-padding: 22 28;
                     -fx-border-color: #dbeafe;
                     -fx-border-width: 0 0 1 0;">

            <VBox>
                <Label text="Seller Dashboard"
                       style="-fx-text-fill: #0284c7; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                <Label text="Quản lý sản phẩm đấu giá"
                       style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="B"
                   style="-fx-background-color: linear-gradient(to bottom right, #38bdf8, #2563eb);
                          -fx-text-fill: white;
                          -fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-alignment: center;
                          -fx-min-width: 42;
                          -fx-min-height: 42;
                          -fx-background-radius: 999;"/>

            <MenuButton text="▼"
                        style="-fx-background-color: white;
                               -fx-text-fill: #0284c7;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-padding: 8 14;
                               -fx-background-radius: 16;
                               -fx-border-radius: 16;
                               -fx-border-color: #bfdbfe;
                               -fx-cursor: hand;">

                <items>
                    <MenuItem text="Hồ sơ tài khoản" onAction="#handleProfile"/>
                    <MenuItem text="Ví đấu giá" onAction="#handleWallet"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Đăng xuất"
                              onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 30;">

            <VBox spacing="16"
                  minWidth="320"
                  maxWidth="340"
                  style="-fx-background-color: white; -fx-padding: 26;
                         -fx-background-radius: 28; -fx-border-radius: 28;
                         -fx-border-color: #dbeafe;
                         -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.16), 18, 0, 0, 8);">

                <Label text="Đăng sản phẩm mới"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <TextField fx:id="fieldItemName"
                           promptText="Tên sản phẩm"
                           style="-fx-pref-height: 46; -fx-background-color: #f8fbff;
                                  -fx-background-radius: 16; -fx-border-radius: 16;
                                  -fx-border-color: #bfdbfe; -fx-padding: 0 14;"/>

                <TextField fx:id="fieldStartPrice"
                           promptText="Giá khởi điểm VNĐ"
                           style="-fx-pref-height: 46; -fx-background-color: #f8fbff;
                                  -fx-background-radius: 16; -fx-border-radius: 16;
                                  -fx-border-color: #bfdbfe; -fx-padding: 0 14;"/>

                <TextField fx:id="fieldDuration"
                           promptText="Thời gian đấu giá giây"
                           style="-fx-pref-height: 46; -fx-background-color: #f8fbff;
                                  -fx-background-radius: 16; -fx-border-radius: 16;
                                  -fx-border-color: #bfdbfe; -fx-padding: 0 14;"/>

                <ComboBox fx:id="comboCategory"
                          maxWidth="Infinity"
                          promptText="Danh mục"
                          style="-fx-pref-height: 46; -fx-background-color: #f8fbff;
                                 -fx-background-radius: 16; -fx-border-radius: 16;
                                 -fx-border-color: #bfdbfe;"/>

                <Button fx:id="buttonPost"
                        text="Đăng sản phẩm"
                        onAction="#handlePostItem"
                        maxWidth="Infinity"
                        style="-fx-background-color: linear-gradient(to right, #38bdf8, #2563eb);
                               -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;
                               -fx-padding: 13; -fx-background-radius: 18; -fx-cursor: hand;"/>

                <Label fx:id="labelResult"
                       text=""
                       wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
            </VBox>

            <VBox spacing="16" HBox.hgrow="ALWAYS">
                <Label text="Sản phẩm đã đăng"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <ListView fx:id="listViewMyItems"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 24;
                                 -fx-border-radius: 24;
                                 -fx-border-color: #dbeafe;
                                 -fx-padding: 12;
                                 -fx-font-size: 14px;">
                    <placeholder>
                        <Label text="Bạn chưa đăng sản phẩm nào."
                               style="-fx-text-fill: #94a3b8;"/>
                    </placeholder>
                </ListView>
                <HBox spacing="10">
                    <Button text="Xem chi tiết phiên" onAction="#handleViewSelectedAuction" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #e0f2fe; -fx-text-fill: #0369a1; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 16;"/>
                    <Button text="Xóa sản phẩm/phiên" onAction="#handleDeleteSelectedAuction" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 16;"/>
                </HBox>
            </VBox>

        </HBox>
    </center>
</BorderPane>