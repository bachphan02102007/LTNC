<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.SellerController"
            style="-fx-background-color: #f4f6f9;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #1a1a2e; -fx-padding: 14 24;">
            <Label text="🏷 Quản lý sản phẩm"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- CENTER: form bên trái | danh sách bên phải -->
    <center>
        <HBox spacing="16" style="-fx-padding: 20;">

            <!-- FORM đăng sản phẩm -->
            <VBox spacing="14" minWidth="280" maxWidth="300"
                  style="-fx-background-color: white; -fx-padding: 20;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;">

                <Label text="📦 Đăng sản phẩm mới"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Separator/>

                <VBox spacing="4">
                    <Label text="Tên sản phẩm *" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <TextField fx:id="fieldItemName" promptText="VD: iPhone 15 Pro Max"
                               style="-fx-padding: 8; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-border-color: #ccc;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Giá khởi điểm (VNĐ) *" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <TextField fx:id="fieldStartPrice" promptText="VD: 5000000"
                               style="-fx-padding: 8; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-border-color: #ccc;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Thời gian đấu giá (giây) *" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <TextField fx:id="fieldDuration" promptText="VD: 120"
                               style="-fx-padding: 8; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-border-color: #ccc;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Danh mục *" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="comboCategory" maxWidth="Infinity"/>
                </VBox>

                <Separator/>

                <Button fx:id="buttonPost" text="🚀 Đăng sản phẩm"
                        onAction="#handlePostItem" maxWidth="Infinity"
                        style="-fx-background-color: #e05c00; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-padding: 10; -fx-background-radius: 8; -fx-cursor: hand;"/>

                <Label fx:id="labelResult" text="" wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
            </VBox>

            <!-- DANH SÁCH sản phẩm đã đăng -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="📋 Sản phẩm đã đăng"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                <ListView fx:id="listViewMyItems" VBox.vgrow="ALWAYS"
                          style="-fx-background-radius: 8; -fx-border-radius: 8;
                                 -fx-border-color: #e0e0e0; -fx-font-size: 13px;">
                    <placeholder>
                        <Label text="Bạn chưa đăng sản phẩm nào."
                               style="-fx-text-fill: #aaa;"/>
                    </placeholder>
                </ListView>
            </VBox>

        </HBox>
    </center>

</BorderPane>
